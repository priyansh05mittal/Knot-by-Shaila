# Base URL of your backend API (leave as /api if using the Vite dev proxy)
VITE_API_URL=/api

# Used only by vite.config.js dev server proxy target
VITE_API_PROXY_TARGET=http://localhost:5000

# Google OAuth Client ID (public, used by Google Identity Services on the frontend)
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Razorpay Key ID (public key, safe to expose on frontend)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
